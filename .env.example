# VoIP to Horns settings (/opt/voiptohorns/.env, mode 600). The installer writes this file.
# UniFi console (required). Saved from the dashboard Config tab (UniFi Console panel).
# Local UniFi OS account with Talk + Protect admin, 2FA off. A UI.com cloud login does not work.
UNIFI_IP=
UNIFI_USERNAME=
UNIFI_PASSWORD=

# SIP Configuration. SIP_SERVER defaults to UNIFI_IP when empty.
SIP_SERVER=
SIP_PORT=5060
# LAN IP of THIS Pi (must match the UniFi Talk contact / DHCP reservation).
# Leave empty to auto-detect the address used to reach UNIFI_IP.
MY_IP=
RTP_PORT=10000

# Dashboard login (required; there is no default password). The installer sets user "admin":
#   printf '%s' "$PW" | ./venv/bin/python3 dashboard/dashboard_auth.py set-login .env
DASHBOARD_USER=admin
DASHBOARD_PASS_HASH=''
