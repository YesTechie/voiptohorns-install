[Unit]
Description=VoIP to Horns SIP bridge (UniFi Talk -> Protect horns)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voiptohorns
Group=voiptohorns
WorkingDirectory=/opt/voiptohorns
ExecStart=/opt/voiptohorns/venv/bin/python3 -u voip_bridge_tcp.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/voiptohorns/bridge_tcp.log
StandardError=append:/opt/voiptohorns/bridge_tcp.log

[Install]
WantedBy=multi-user.target
